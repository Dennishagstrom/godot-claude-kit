[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/menu/main_menu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Center"]
layout_mode = 2

[node name="Title" type="Label" parent="Center/Box"]
layout_mode = 2
text = "{{GAME_NAME}}"
horizontal_alignment = 1
{{#MULTIPLAYER}}
[node name="NameEdit" type="LineEdit" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Your name"
max_length = 16

[node name="HostButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Host"

[node name="AddressEdit" type="LineEdit" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Address (127.0.0.1)"

[node name="JoinButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Join"
{{/MULTIPLAYER}}{{^MULTIPLAYER}}
[node name="PlayButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Play"
{{/MULTIPLAYER}}
[node name="QuitButton" type="Button" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Quit"
{{#MULTIPLAYER}}
[node name="Status" type="Label" parent="Center/Box"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
{{/MULTIPLAYER}}
