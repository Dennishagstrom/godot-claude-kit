# Editor settings for every editor that reads .editorconfig (Godot does too).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,tscn,tres,cfg,godot}]
indent_style = tab

[*.sh]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
